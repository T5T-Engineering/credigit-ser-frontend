{
  "apps": [
    {
      "name": "credigit-ser-frontend",
      "cwd": ".",
      "script": "serve.mjs",
      "interpreter": "node",
      "exec_mode": "fork",
      "instances": 1,
      "max_memory_restart": "256M",
      "exp_backoff_restart_delay": 200,
      "max_restarts": 16,
      "min_uptime": 10000,
      "kill_timeout": 5000,
      "merge_logs": true,
      "time": true,
      "env": { "NODE_ENV": "production", "HOST": "0.0.0.0", "PORT": "8061" },
      "env_dev": {
        "NODE_ENV": "production",
        "HOST": "0.0.0.0",
        "PORT": "8061"
      },
      "env_test": {
        "NODE_ENV": "production",
        "HOST": "0.0.0.0",
        "PORT": "8061"
      },
      "env_uat": {
        "NODE_ENV": "production",
        "HOST": "0.0.0.0",
        "PORT": "8061"
      },
      "env_staging": {
        "NODE_ENV": "production",
        "HOST": "0.0.0.0",
        "PORT": "8061"
      },
      "env_production": {
        "NODE_ENV": "production",
        "HOST": "0.0.0.0",
        "PORT": "8061"
      }
    }
  ]
}
