# Backend API gateway origin (API mode). Leave empty for demo mode (browser-side seeded data).
NEXT_PUBLIC_API_URL=
# Tenant of this deployment (tenant-scoped brand storage). Demo tenant when empty.
NEXT_PUBLIC_TENANT_ID=
# Demo mode only: sign-in mode to simulate (Local | MicrosoftEntra). API mode reads GET /api/v1/auth/config.
NEXT_PUBLIC_AUTH_MODE=Local
# Microsoft Entra ID (used when the backend config doesn't provide them, e.g. demo mode). Not secrets.
NEXT_PUBLIC_AZURE_AD_CLIENT_ID=
# e.g. https://login.microsoftonline.com/<tenant-id>/v2.0
NEXT_PUBLIC_AZURE_AD_AUTHORITY=
# Space- or comma-separated API scopes, e.g. api://<api>/access_as_user
NEXT_PUBLIC_AZURE_AD_SCOPES=
# Optional; defaults to /login/
NEXT_PUBLIC_AZURE_AD_REDIRECT_URI=
# Show the demo role picker on the sign-in page (demo mode only).
NEXT_PUBLIC_DEMO_ACCESS=true
# Demo mode only, optional: password for every seeded demo user. Empty = users set one via "Set or reset your password".
NEXT_PUBLIC_DEMO_PASSWORD=
