# Microsoft Entra ID (Azure AD) single sign-on — leave CLIENT_ID empty to use demo access only.
# Register a "Single-page application" with redirect URI <site>/login/ (and http://localhost:3100/login/).
NEXT_PUBLIC_AZURE_AD_CLIENT_ID=
# Directory (tenant) ID, or "organizations" to allow any work account.
NEXT_PUBLIC_AZURE_AD_TENANT_ID=
# Optional; defaults to <origin>/login/
NEXT_PUBLIC_AZURE_AD_REDIRECT_URI=
# Show the demo role picker on the sign-in page (true for customer prototypes).
NEXT_PUBLIC_DEMO_ACCESS=true
# Backend API origin (e.g. http://localhost:5080). When set, "Sign in with Microsoft" uses the backend code flow:
# register <site>/callback/ as a Web redirect URI in Entra and as Authentication:MicrosoftSignIn:PortalRedirectUri in the backend.
NEXT_PUBLIC_API_BASE_URL=
# Workspace data store (backend ADR-0015): with NEXT_PUBLIC_API_BASE_URL set, the app's data is loaded from and saved to MongoDB.
# Browser-only sign-ins (demo role picker, browser email + password) call the API with the backend's development identity headers —
# only for a backend running in Development. Leave false anywhere else.
NEXT_PUBLIC_BACKEND_DEV_IDENTITY=false
# Tenant sent with the development identity headers (the backend's Authentication:Local:DefaultTenantId, e.g. tenant-a).
NEXT_PUBLIC_BACKEND_DEV_TENANT=
# Optional batching limits for saving (defaults: 400000 bytes, 500 documents, 400 ms).
NEXT_PUBLIC_WORKSPACE_MAX_PATCH_BYTES=
NEXT_PUBLIC_WORKSPACE_MAX_PATCH_DOCUMENTS=
NEXT_PUBLIC_WORKSPACE_SAVE_DELAY_MS=
# Most server audit entries the audit page loads (default 2000).
NEXT_PUBLIC_AUDIT_MAX_ROWS=
